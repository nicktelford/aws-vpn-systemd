[Unit]
Description=AWS Client VPN for %I
Documentation=man:openvpn(8)
Documentation=https://openvpn.net/community-resources/reference-manual-for-openvpn-2-6/
Documentation=https://github.com/nicktelford/aws-vpn-systemd

[Service]
Type=notify
NotifyAccess=all

# Only signal the main aws-vpn script on stop, so its TERM trap can deliver
# 'signal SIGHUP' to OpenVPN over the management socket before the socat
# coproc is reaped (its EXIT trap cleans up the coproc afterwards). The
# default control-group mode SIGTERMs the coproc concurrently, racing the
# SIGHUP and leaving OpenVPN connected with stale routes.
KillMode=process

Restart=on-failure
RestartSec=2s
RestartMaxDelaySec=60s

TimeoutStartSec=infinity
EnvironmentFile=-/etc/default/aws-vpn-systemd
ExecStart=/usr/bin/aws-vpn %i

DevicePolicy=closed

[Install]
WantedBy=default.target
